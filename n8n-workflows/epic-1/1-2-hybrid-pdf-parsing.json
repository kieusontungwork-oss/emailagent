{
  "name": "1.2 Hybrid PDF Parsing (Text & Scanned)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const execId = $execution.id || 'dev-' + Date.now() + '-' + Math.random().toString(36).substring(2, 9);\nconst workspace = `/tmp/emailagentv2/${execId}`;\nlet binary = $input.first()?.binary;\nif (!binary || !binary.attachment_0) {\n  try {\n    for (const item of $input.all()) {\n      if (item.binary?.attachment_0) { binary = item.binary; break; }\n    }\n  } catch(e) {}\n}\nreturn { json: { workspace }, ...(binary ? { binary } : {}) };"
      },
      "id": "init-workspace",
      "name": "Init Workspace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "command": "=mkdir -p \"{{$json.workspace}}\""
      },
      "id": "mkdir",
      "name": "Create Workspace Dir",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "fileName": "={{$json.workspace}}/input.pdf",
        "dataPropertyName": "attachment_0"
      },
      "id": "write-pdf",
      "name": "Write PDF to Disk",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ]
    },
    {
      "parameters": {
        "command": "=pdftk \"{{$('Init Workspace').first().json.workspace}}/input.pdf\" burst output \"{{$('Init Workspace').first().json.workspace}}/page_%03d.pdf\""
      },
      "id": "split-pages",
      "name": "Split PDF into Pages",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "command": "=ls \"{{$('Init Workspace').first().json.workspace}}\"/page_*.pdf"
      },
      "id": "list-pages",
      "name": "List Page Files",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const rawStdout = $input.first().json.stdout ? $input.first().json.stdout : '';\nconst stdout = rawStdout.replace(/\\r/g, '').trim();\nif (!stdout) return [];\nconst files = stdout.split('\\n').map(f => f.trim()).filter(f => f.length > 0);\nconst workspace = $('Init Workspace').first().json.workspace;\nreturn files.map((f, idx) => ({ json: { pagePath: f, pageIndex: idx, workspace } }));"
      },
      "id": "split-items",
      "name": "Create Item Per Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "command": "=pdftotext \"{{$json.pagePath}}\" -"
      },
      "id": "extract-text",
      "name": "Extract Text to Check Density",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1400,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ ($json.stdout || '').replace(/[\\s\\x00-\\x1F\\x7F]/g, '').length }}",
              "value2": 50,
              "operation": "gte"
            }
          ]
        }
      },
      "id": "if-text-heavy",
      "name": "Is Text-Heavy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1600,
        0
      ]
    },
    {
      "parameters": {
        "command": "=markitdown \"{{$json.pagePath}}\""
      },
      "id": "markitdown",
      "name": "Convert via markitdown",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1800,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "return { json: { pageIndex: $json.pageIndex, markdown: $json.stdout || '' } };"
      },
      "id": "format-text-md",
      "name": "Format Text MD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        -100
      ]
    },
    {
      "parameters": {
        "command": "=pdftoppm -jpeg -singlefile \"{{$json.pagePath}}\" \"{{$json.pagePath}}_img\""
      },
      "id": "pdf-to-img",
      "name": "Convert Scanned to Image",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1800,
        100
      ]
    },
    {
      "parameters": {
        "filePath": "={{ $('Create Item Per Page').item.json.pagePath }}_img.jpg",
        "dataPropertyName": "page_image"
      },
      "id": "read-img",
      "name": "Read Image File",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [
        2000,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://' + ($env.LM_STUDIO_HOST || 'lm-studio:1234') + '/v1/chat/completions' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "Llama-3.2-Vision"
            },
            {
              "name": "messages",
              "value": "={{ [{ role: 'user', content: [ { type: 'text', text: 'Extract all text from this image and format it as Markdown. Do not add any conversational text.' }, { type: 'image_url', image_url: { url: 'data:' + $binary.page_image.mimeType + ';base64,' + $binary.page_image.data } } ] }] }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "vision-llm",
      "name": "Vision LLM (LM Studio)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2200,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const pageIndex = $('Create Item Per Page').item.json.pageIndex;\nconst content = $json?.choices?.[0]?.message?.content || '[OCR Failed: No content from Vision LLM]';\nreturn { json: { pageIndex, markdown: content } };"
      },
      "id": "format-scanned-md",
      "name": "Format Scanned MD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nitems.sort((a, b) => (a.json.pageIndex ?? 0) - (b.json.pageIndex ?? 0));\nreturn items;"
      },
      "id": "sort-pages",
      "name": "Sort Pages by Index",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        0
      ]
    },
    {
      "parameters": {
        "operation": "concatenateItems",
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "markdown",
              "renameField": "full_markdown"
            }
          ]
        },
        "options": {
          "separator": "\n\n---\n\n"
        }
      },
      "id": "aggregate-md",
      "name": "Aggregate Markdown",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        2650,
        0
      ]
    },
    {
      "parameters": {
        "command": "=rm -rf \"{{$('Init Workspace').first().json.workspace}}\""
      },
      "id": "cleanup",
      "name": "Cleanup Workspace",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2800,
        0
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const markdown = $('Aggregate Markdown').first().json.full_markdown || '';\nreturn { json: { full_markdown: markdown } };"
      },
      "id": "return",
      "name": "Return to Controller",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const workspace = $('Init Workspace').first().json.workspace;\nlet binary = $input.first()?.binary;\nlet att = binary?.attachment_0 || binary?.data;\nif (!att) {\n  try {\n    const b = $('Init Workspace').first()?.binary;\n    att = b?.attachment_0 || b?.data;\n  } catch(e) {}\n}\nif (!att) {\n  const candidateNodes = ['Execute Workflow Trigger', 'Read File(s) From Disk', 'Read/Write Files from Disk'];\n  for (const name of candidateNodes) {\n    try {\n      const b = $(name).first()?.binary;\n      if (b?.attachment_0 || b?.data) {\n        att = b.attachment_0 || b.data;\n        break;\n      }\n    } catch(e) {}\n  }\n}\nreturn {\n  json: { workspace },\n  binary: att ? { attachment_0: att } : {}\n};"
      },
      "id": "prep-binary",
      "name": "Prepare Workspace & Binary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        0
      ]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/n8n-workflows/CVDEN_001.pdf",
        "options": {
          "dataPropertyName": "attachment_0"
        }
      },
      "id": "read-file-test",
      "name": "Read/Write Files from Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        200,
        -120
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Read/Write Files from Disk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Workspace": {
      "main": [
        [
          {
            "node": "Create Workspace Dir",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Workspace Dir": {
      "main": [
        [
          {
            "node": "Prepare Workspace & Binary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write PDF to Disk": {
      "main": [
        [
          {
