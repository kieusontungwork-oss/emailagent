            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Image File": {
      "main": [
        [
          {
            "node": "Vision LLM (LM Studio)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vision LLM (LM Studio)": {
      "main": [
        [
          {
            "node": "Format Scanned MD",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Text MD": {
      "main": [
        [
          {
            "node": "Sort Pages by Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Scanned MD": {
      "main": [
        [
          {
            "node": "Sort Pages by Index",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sort Pages by Index": {
