          }
        ]
      ]
    },
    "Is Text-Heavy?": {
      "main": [
        [
          {
            "node": "Convert via markitdown",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Convert Scanned to Image",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert via markitdown": {
      "main": [
